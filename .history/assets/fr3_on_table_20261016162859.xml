<mujoco model="fr3_on_table">
    <compiler angle="radian" meshdir="mj_assets" autolimits="true" inertiafromgeom="auto" inertiagrouprange="4 4"/>
    <statistic center="0.3 0 0.4" extent="1"/>
    <option integrator="implicitfast"/>
    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="120" elevation="-20"/>
    </visual>
    <asset>
        <include file="./table_assets.xml"/>
        <include file="./fr3_assets.xml"/>
        <mesh name="cup" file="cup.obj" scale="4 4 1"/>
    </asset>
    <default>
        <include file="./table_default.xml"/>
        <include file="./fr3_default.xml"/>
    </default>
    <worldbody>
        <light name="top" pos="0 0 2" mode="trackcom"/>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <body name="fixed_camera" pos="0 -0.4 0.8">
            <camera name="franka_camera" mode="fixed" euler="-1.5708 0 3.1416" focalpixel="250 250" principalpixel="0 0" resolution="500 500" sensorsize="2e-2 2e-2"/>
        </body>
        <include file="./table_body.xml"/>
        <include file="./fr3_on_table_body.xml"/>
        <!-- 2. Blue Cylindrical Object on Table -->
        <!-- Blue Cylindrical Object on Table -->
        <!-- Blue Cylindrical Object on Table -->
        <body name="blue_cylinder" pos="0.28 0.08 0.88" euler="0.785 0 0">
            <joint type="free"/>
            <inertial mass="0.05" pos="0 0 0" fullinertia="0.001 0.001 0.001 0 0 0"/>
            <geom name="blue_cylinder_geom" size="0.025 0.04" type="cylinder" rgba="0.1 0.3 0.9 1" friction="0.95 0.3 0.1" condim="4"/>
            <!-- Site 1: Center of the Top Surface Plane -->
            <site name="cylinder_center" pos="0 0 0.04" size="0.003" rgba="1 1 0 1"/>
            <!-- Site 2: Top Surface Plane - Corner 1 (+X, +Y) -->
            <site name="cylinder_top" pos="0.015 0.015 0.04" size="0.003" rgba="1 1 0 1"/>
            <!-- Site 3: Top Surface Plane - Corner 2 (-X, -Y) -->
            <site name="cylinder_bottom" pos="-0.015 -0.015 0.04" size="0.003" rgba="1 1 0 1"/>
            <!-- Site 4: Top Surface Plane - Corner 3 (+X, -Y) -->
            <site name="cylinder_side_x" pos="0.015 -0.015 0.04" size="0.003" rgba="1 1 0 1"/>
            <!-- Site 5: Top Surface Plane - Corner 4 (-X, +Y) -->
            <site name="cylinder_side_y" pos="-0.015 0.015 0.04" size="0.003" rgba="1 1 0 1"/>
        </body>
        <body name="target_box_body" pos="0 0.3 0.85">
            <!-- Bottom -->
            <geom name="box_bottom" type="box" pos="0 0 -0.01" size="0.1 0.1 0.01" rgba="1 0 0 0.5" />
            <!-- Left Wall -->
            <geom name="box_left" type="box" pos="-0.09 0 0.04" size="0.01 0.1 0.05" rgba="1 0 0 0.5"/>
            <!-- Right Wall -->
            <geom name="box_right" type="box" pos="0.09 0 0.04" size="0.01 0.1 0.05" rgba="1 0 0 0.5"/>
            <!-- Front Wall -->
            <geom name="box_front" type="box" pos="0 -0.09 0.04" size="0.1 0.01 0.05" rgba="1 0 0 0.5"/>
            <!-- Back Wall -->
            <geom name="box_back" type="box" pos="0 0.09 0.04" size="0.1 0.01 0.05" rgba="1 0 0 0.5"/>
            <!-- Box Center Site -->
            <site name="box_center" pos="0 0 0.01" size="0.005" rgba="0 1 0 1"/>
            <!-- Box Top-Corner Sites -->
            <site name="box_corner_front_left" pos="-0.1 -0.1 0.09" size="0.005" rgba="1 1 0 1"/>
            <site name="box_corner_front_right" pos="0.1 -0.1 0.09" size="0.005" rgba="1 1 0 1"/>
            <site name="box_corner_back_left" pos="-0.1 0.1 0.09" size="0.005" rgba="1 1 0 1"/>
            <site name="box_corner_back_right" pos="0.1 0.1 0.09" size="0.005" rgba="1 1 0 1"/>
        </body>
        <!-- Red X axis -->
        <geom type="capsule" fromto="0 0 0 0.1 0 0" size="0.008" rgba="1 0 0 1"/>
        <!-- Green Y axis -->
        <geom type="capsule" fromto="0 0 0 0 0.1 0" size="0.008" rgba="0 1 0 1"/>
        <!-- Blue Z axis -->
        <geom type="capsule" fromto="0 0 0 0 0 0.1" size="0.008" rgba="0 0 1 1"/>
    </worldbody>
    <include file="./fr3_motors.xml"/>
    <sensor>
        <force name="ee_force" site="right_finger_site"/>
        <torque name="ee_torque" site="right_finger_site"/>
    </sensor>
    <equality>
    </equality>
</mujoco>